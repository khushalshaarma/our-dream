# 🎀 oops, midnight! — Configuration & API Keys

# Secret entrance passcode (default: 08/08/2026)
MIDNIGHT_SECRET_CODE=08/08/2026

# The Movie Database (TMDB) API Key (Free for personal projects)
# 1. Sign up at https://www.themoviedb.org
# 2. Go to Settings -> API -> Request API Key (Developer)
# 3. Paste key below to unlock official posters, widescreen backdrops, genres & ratings!
TMDB_API_KEY=

# (Optional) OMDb API Key fallback
# OMDB_API_KEY=
